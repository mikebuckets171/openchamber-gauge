{
  "name": "openchamber-gauge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "OpenChamber Work Status section: live tokens/s, prompt progress, render progress and Mac memory in one place.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikebuckets171/openchamber-gauge.git"
  },
  "homepage": "https://github.com/mikebuckets171/openchamber-gauge#readme",
  "bugs": {
    "url": "https://github.com/mikebuckets171/openchamber-gauge/issues"
  },
  "keywords": [
    "openchamber",
    "extension",
    "tokens-per-second",
    "tps",
    "throughput",
    "latency",
    "comfyui",
    "status-panel"
  ],
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "contributes": {
      "panel": {
        "id": "gauge",
        "name": "Gauge",
        "icon": "gauge"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "Gauge",
        "height": 225
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "keepRunning": true,
        "permissions": {
          "exec": [
            "/usr/bin/vm_stat",
            "/usr/sbin/sysctl",
            "/usr/sbin/lsof"
          ],
          "sockets": []
        }
      },
      "sessionEvents": {
        "events": [
          "turn-started",
          "turn-finished",
          "turn-failed",
          "session-created"
        ]
      },
      "opencodePlugin": "bridge/opencode"
    }
  },
  "scripts": {
    "build": "bun run build:status && bun run build:service",
    "build:status": "bunx openchamber-guest-bundle status/main.ts status/main.js",
    "build:service": "bunx openchamber-guest-bundle --node service/main.ts service/main.js",
    "type-check": "tsc --noEmit",
    "test": "node scripts/smoke.mjs && node scripts/regressions.mjs && node scripts/page-smoke.mjs && node scripts/cache.mjs && node --test bridge/opencode/*.test.js",
    "test:bridge": "node --test bridge/opencode/*.test.js"
  },
  "dependencies": {
    "@openchamber/sdk": "2.7.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.4",
    "@types/node": "^22.20.3",
    "typescript": "7.0.2"
  }
}
